{
  "name": "quality",
  "implicitDependencies": ["web", "domain", "extension"],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/tests/**/*",
      "{workspaceRoot}/*.ts",
      "{workspaceRoot}/tsconfig.tools.json",
      "{workspaceRoot}/libs/domain/**/*",
      "{workspaceRoot}/apps/web/src/lib/**/*",
      "sharedGlobals",
      "{workspaceRoot}/apps/extension/src/**/*",
      "{workspaceRoot}/apps/web/src/server/**/*",
      "{workspaceRoot}/apps/web/migrations/**/*",
      "{workspaceRoot}/apps/web/scripts/**/*",
      "{workspaceRoot}/apps/web/src/app/**/*.css"
    ]
  },
  "targets": {
    "test": {
      "command": "vitest run",
      "outputs": []
    },
    "lint": {
      "command": "eslint tests vitest*.config.ts playwright*.config.ts --max-warnings=0"
    },
    "typecheck": {
      "command": "tsc -p tsconfig.tools.json --noEmit"
    },
    "e2e": {
      "command": "playwright test",
      "cache": false
    },
    "integration": {
      "command": "vitest run --config vitest.integration.config.ts",
      "cache": false
    }
  }
}

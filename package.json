{
  "name": "fats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "nx run web:dev --output-style=stream",
    "build": "nx run web:build --output-style=static",
    "start": "nx run web:start --output-style=stream",
    "lint": "nx run-many -t lint --output-style=static",
    "typecheck": "nx run-many -t typecheck --output-style=static",
    "test": "nx run quality:test --output-style=stream",
    "test:e2e": "nx run quality:e2e --output-style=stream",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:extension": "nx run extension:build --output-style=static",
    "verify:extension": "pnpm --filter @fats/extension verify",
    "test:extension": "pnpm build:extension && pnpm verify:extension && playwright test --config=playwright.extension.config.ts",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local apps/web/scripts/migrate.mjs",
    "db:up": "docker compose --env-file apps/web/.env.local up -d --wait",
    "db:stop": "docker compose --env-file apps/web/.env.local stop",
    "test:integration": "node --env-file-if-exists=.env.phase4-test node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e:account": "node --env-file-if-exists=.env.phase4-test node_modules/@playwright/test/cli.js test --config=playwright.account.config.ts",
    "test:extension:account": "pnpm build:extension && pnpm verify:extension && node --env-file-if-exists=.env.phase4-test node_modules/@playwright/test/cli.js test --config=playwright.extension.account.config.ts",
    "db:configure": "node apps/web/scripts/configure-local.mjs",
    "db:test:up": "node apps/web/scripts/test-database.mjs up",
    "db:test:stop": "node apps/web/scripts/test-database.mjs stop",
    "mail:test:up": "node apps/web/scripts/mail-test.mjs up",
    "mail:test:stop": "node apps/web/scripts/mail-test.mjs stop",
    "db:backup": "node --env-file-if-exists=apps/web/.env.local apps/web/scripts/database.mjs backup",
    "db:restore": "node --env-file-if-exists=apps/web/.env.local apps/web/scripts/database.mjs restore"
  },
  "devDependencies": {
    "@fats/domain": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "nx": "23.3.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
